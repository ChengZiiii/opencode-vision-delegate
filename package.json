{
  "name": "opencode-vision-delegate",
  "version": "0.2.0",
  "description": "Visual bridge for opencode. Registers the native vision_analyze tool (model configured by the user via the opencode agent model override on vision-agent) with the vision-agent subagent as fallback, and teaches a text-only orchestrator to extract visual intent, design a task-specific JSON response template, and delegate via the tool (or subagent).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "bundle": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bun build ./plugin.ts --outfile ./dist/index.js --target node --format esm",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "vision",
    "visual-judgment",
    "image-analysis",
    "screenshot",
    "subagent",
    "skill"
  ],
  "license": "MIT",
  "author": "chengsongren",
  "homepage": "https://github.com/ChengZiiii/opencode-vision-delegate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChengZiiii/opencode-vision-delegate.git"
  },
  "bugs": {
    "url": "https://github.com/ChengZiiii/opencode-vision-delegate/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "opencode": "^1.18.0"
  }
}
